diff --git a/core/rf_state.h b/core/rf_state.h
new file mode 100644
index 0000000..2310404
--- /dev/null
+++ b/core/rf_state.h
@@ -0,0 +1,37 @@
+/* Save states iguais no iPad (armv7, 32 bits) e no Switch (arm64).
+ * Quatro structs do núcleo são gravados crus no state e mudam de tamanho com ponteiros de 8 bytes.
+ * No Switch eles passam a ser gravados no layout do iPad (os ponteiros vão zerados: o núcleo
+ * os refaz ao carregar). rf_state_native = 1 lê/grava o formato antigo do Switch (states locais antigos). */
+#ifndef RF_STATE_H
+#define RF_STATE_H
+#include <string.h>
+#include "rf_state_tables.h"
+
+extern int rf_state_native;
+
+/* As tabelas valem para o arm64 (Switch); em 32 bits o layout já é o do iPad */
+#if defined(__aarch64__) || defined(__LP64__)
+#define RF_CANON 1
+#else
+#define RF_CANON 0
+#endif
+
+static inline int rf_canon_save(unsigned char *dst, const void *src, const rf_run *t, int canon, int native)
+{
+  if (rf_state_native || !RF_CANON) { memcpy(dst, src, native); return native; }
+  memset(dst, 0, canon);
+  for (; t->size; t++) memcpy(dst + t->canon, (const unsigned char *)src + t->native, t->size);
+  return canon;
+}
+
+static inline int rf_canon_load(void *dst, const unsigned char *src, const rf_run *t, int canon, int native)
+{
+  if (rf_state_native || !RF_CANON) { memcpy(dst, src, native); return native; }
+  for (; t->size; t++) memcpy((unsigned char *)dst + t->native, src + t->canon, t->size);
+  return canon;
+}
+
+#define RF_CHECK(var, name) ((void)sizeof(char[(!RF_CANON || sizeof(var) == name##_NATIVE_SZ) ? 1 : -1]))
+#define RF_SAVE(var, name) RF_CHECK(var, name); bufferptr += rf_canon_save(&state[bufferptr], &(var), name, name##_CANON_SZ, sizeof(var))
+#define RF_LOAD(var, name) RF_CHECK(var, name); bufferptr += rf_canon_load(&(var), &state[bufferptr], name, name##_CANON_SZ, sizeof(var))
+#endif
