diff --git a/source/rf_state.h b/source/rf_state.h
new file mode 100644
index 0000000..ce95e7f
--- /dev/null
+++ b/source/rf_state.h
@@ -0,0 +1,192 @@
+/* Save states iguais no iPad (armv7, 32 bits) e no Switch (arm64).
+ * Seis structs do núcleo vão crus para o state e mudam de layout com ponteiros e `long` de 8 bytes.
+ * No Switch eles são gravados no layout do iPad: ponteiros zerados (o núcleo os refaz ao carregar),
+ * `long` com 4 bytes, e os ponteiros do SPC700 (IAPU) relativos à RAM dele, como o núcleo espera.
+ * States antigos deste Switch (tamanho do formato nativo) continuam abrindo. */
+#ifndef RF_STATE_H
+#define RF_STATE_H
+#include <stdint.h>
+#include <string.h>
+#include <stddef.h>
+
+typedef struct { unsigned int native, canon, size; } rf_run;
+typedef struct { unsigned int native, canon; } rf_long;
+/* SCPUState: 128 bytes no Switch, 80 bytes no formato do iPad (armv7) */
+static const rf_run rf_cpu[] = {
+  {0, 0, 10},
+  {48, 28, 4},
+  {104, 56, 5},
+  {112, 64, 6},
+  {120, 72, 8},
+  {0, 0, 0}
+};
+static const rf_long rf_cpu_longs[] = {
+  {56, 32},
+  {64, 36},
+  {72, 40},
+  {80, 44},
+  {88, 48},
+  {96, 52},
+};
+#define rf_cpu_NLONGS 6
+#define rf_cpu_LONGS rf_cpu_longs
+#define rf_cpu_NATIVE_SZ 128
+#define rf_cpu_CANON_SZ 80
+/* SICPU: 64 bytes no Switch, 52 bytes no formato do iPad (armv7) */
+static const rf_run rf_icpu[] = {
+  {16, 8, 21},
+  {40, 32, 20},
+  {0, 0, 0}
+};
+#define rf_icpu_NLONGS 0
+#define rf_icpu_LONGS NULL
+#define rf_icpu_NATIVE_SZ 64
+#define rf_icpu_CANON_SZ 52
+/* SIAPU: 80 bytes no Switch, 60 bytes no formato do iPad (armv7) */
+static const rf_run rf_iapu[] = {
+  {8, 4, 1},
+  {10, 6, 6},
+  {32, 20, 2},
+  {36, 24, 4},
+  {56, 36, 7},
+  {64, 44, 16},
+  {0, 0, 0}
+};
+#define rf_iapu_NLONGS 0
+#define rf_iapu_LONGS NULL
+#define rf_iapu_NATIVE_SZ 80
+#define rf_iapu_CANON_SZ 60
+/* SSoundData: 1448 bytes no Switch, 1284 bytes no formato do iPad (armv7) */
+static const rf_run rf_sound[] = {
+  {0, 0, 49},
+  {52, 52, 10},
+  {64, 64, 66},
+  {144, 136, 12},
+  {168, 152, 10},
+  {180, 164, 15},
+  {200, 180, 25},
+  {228, 208, 10},
+  {240, 220, 66},
+  {320, 292, 12},
+  {344, 308, 10},
+  {356, 320, 15},
+  {376, 336, 25},
+  {404, 364, 10},
+  {416, 376, 66},
+  {496, 448, 12},
+  {520, 464, 10},
+  {532, 476, 15},
+  {552, 492, 25},
+  {580, 520, 10},
+  {592, 532, 66},
+  {672, 604, 12},
+  {696, 620, 10},
+  {708, 632, 15},
+  {728, 648, 25},
+  {756, 676, 10},
+  {768, 688, 66},
+  {848, 760, 12},
+  {872, 776, 10},
+  {884, 788, 15},
+  {904, 804, 25},
+  {932, 832, 10},
+  {944, 844, 66},
+  {1024, 916, 12},
+  {1048, 932, 10},
+  {1060, 944, 15},
+  {1080, 960, 25},
+  {1108, 988, 10},
+  {1120, 1000, 66},
+  {1200, 1072, 12},
+  {1224, 1088, 10},
+  {1236, 1100, 15},
+  {1256, 1116, 25},
+  {1284, 1144, 10},
+  {1296, 1156, 66},
+  {1376, 1228, 12},
+  {1400, 1244, 10},
+  {1412, 1256, 15},
+  {1432, 1272, 12},
+  {0, 0, 0}
+};
+#define rf_sound_NLONGS 0
+#define rf_sound_LONGS NULL
+#define rf_sound_NATIVE_SZ 1448
+#define rf_sound_CANON_SZ 1284
+/* SSA1: 65680 bytes no Switch, 32868 bytes no formato do iPad (armv7) */
+static const rf_run rf_sa1[] = {
+  {8, 4, 5},
+  {16, 12, 17},
+  {80, 52, 4},
+  {65640, 32832, 36},
+  {0, 0, 0}
+};
+#define rf_sa1_NLONGS 0
+#define rf_sa1_LONGS NULL
+#define rf_sa1_NATIVE_SZ 65680
+#define rf_sa1_CANON_SZ 32868
+/* S7RTC: 32 bytes no Switch, 24 bytes no formato do iPad (armv7) */
+static const rf_run rf_rtc[] = {
+  {0, 0, 20},
+  {0, 0, 0}
+};
+static const rf_long rf_rtc_longs[] = {
+  {24, 20},
+};
+#define rf_rtc_NLONGS 1
+#define rf_rtc_LONGS rf_rtc_longs
+#define rf_rtc_NATIVE_SZ 32
+#define rf_rtc_CANON_SZ 24
+
+#if defined(__aarch64__) || defined(__LP64__)
+#define RF_CANON 1
+#else
+#define RF_CANON 0
+#endif
+
+static int rf_native;   /* 1 = lendo um state antigo, no layout nativo */
+
+static uint8_t *rf_put(uint8_t *dst, const void *src, const rf_run *r, const rf_long *l, int nl, size_t canon, size_t native)
+{
+   int i;
+   if (!RF_CANON) { memcpy(dst, src, native); return dst + native; }
+   memset(dst, 0, canon);
+   for (; r->size; r++) memcpy(dst + r->canon, (const uint8_t *)src + r->native, r->size);
+   for (i = 0; i < nl; i++)
+   {
+      long v; int32_t w;
+      memcpy(&v, (const uint8_t *)src + l[i].native, sizeof(v));
+      w = (int32_t)v;
+      memcpy(dst + l[i].canon, &w, 4);
+   }
+   return dst + canon;
+}
+
+static const uint8_t *rf_get(void *dst, const uint8_t *src, const rf_run *r, const rf_long *l, int nl, size_t canon, size_t native)
+{
+   int i;
+   if (!RF_CANON || rf_native) { memcpy(dst, src, native); return src + native; }
+   for (; r->size; r++) memcpy((uint8_t *)dst + r->native, src + r->canon, r->size);
+   for (i = 0; i < nl; i++)
+   {
+      int32_t w; long v;
+      memcpy(&w, src + l[i].canon, 4);
+      v = w;
+      memcpy((uint8_t *)dst + l[i].native, &v, sizeof(v));
+   }
+   return src + canon;
+}
+
+#define RF_CHECK(var, n) ((void)sizeof(char[(!RF_CANON || sizeof(var) == n##_NATIVE_SZ) ? 1 : -1]))
+#define RF_PUT(var, n) (RF_CHECK(var, n), buffer = rf_put(buffer, &(var), n, n##_LONGS, n##_NLONGS, n##_CANON_SZ, sizeof(var)))
+#define RF_GET(var, n) (RF_CHECK(var, n), buffer = rf_get(&(var), buffer, n, n##_LONGS, n##_NLONGS, n##_CANON_SZ, sizeof(var)))
+#define RF_SIZE(var, n) (RF_CANON ? (size_t)n##_CANON_SZ : sizeof(var))
+
+/* Ponteiros do SPC700 no formato do iPad: u32 nas posições do struct de 32 bits, relativos a uma RAM fictícia */
+#define RF_IAPU_RAM_BASE 0x10000000u
+static const struct { unsigned int canon; size_t native; } rf_iapu_ptrs[] = {
+   { 0, offsetof(SIAPU, PC) }, { 16, offsetof(SIAPU, DirectPage) },
+   { 28, offsetof(SIAPU, WaitAddress1) }, { 32, offsetof(SIAPU, WaitAddress2) },
+};
+#define RF_IAPU_RAM_CANON 12
+#endif
